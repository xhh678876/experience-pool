{
  "name": "@experience-pool/cli",
  "version": "0.1.0",
  "description": "TypeScript CLI for the Experience Pool. HTTP client for the FastAPI gateway. Distributed via npm so updates flow centrally.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "agent",
    "experience-pool",
    "skill"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
