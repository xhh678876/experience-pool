# Experience Pool — example environment configuration
#
# Copy to `.env` (or export in your systemd unit) and adjust. Every value
# here has a safe default for local development; the ones marked [PROD]
# should be set explicitly before exposing the service publicly.
#
# Nothing in this file is secret — fill real secrets into your own .env,
# which is git-ignored.

# ----- Core storage -----
# Root dir for the SQLite DB, credentials, and trajectories.
EXP_ROOT=/var/lib/expool
# Override just the DB path (defaults to $EXP_ROOT/pool.db).
# EXP_DB_PATH=/var/lib/expool/pool.db

# ----- Network -----
# Public base URL of the API gateway, used when rendering bind/install scripts.
EXP_BASE_URL=http://127.0.0.1:8080
# Public URL of the Next.js UI (used in emails / bind hints).
EXP_UI_PUBLIC_URL=http://127.0.0.1:3000

# ----- [PROD] Registration gates -----
# By default registration is OPEN so `curl <base>/install | bash` works out of
# the box. On a publicly reachable deployment this lets anyone create accounts.
# Set these to a long random secret to require the matching X-Register-Token /
# X-User-Register-Token header on registration. The server logs a warning at
# startup whenever either is unset.
# EXP_REGISTER_TOKEN=change-me-long-random
# EXP_USER_REGISTER_TOKEN=change-me-long-random

# Restrict web sign-ups to a single email domain (empty = allow any).
# EXP_EMAIL_DOMAIN=example.com

# ----- [PROD] Admin + sessions -----
# Admin endpoints (/v1/admin/*) are fail-closed: unset = disabled.
# EXP_ADMIN_TOKEN=change-me-long-random
# Signing secret for session cookies. If unset, a random one is generated and
# persisted under $EXP_ROOT on first run; set it explicitly for multi-host.
# EXP_SESSION_SECRET=change-me-long-random
# Set to 1 to mark the session cookie Secure (required behind HTTPS).
# EXP_SESSION_COOKIE_SECURE=1

# ----- Rate limiting (per client, per minute) -----
EXP_RATE_LIMIT_ENABLED=1
# EXP_RATE_REGISTER_PER_MIN=30
# EXP_RATE_USER_REGISTER_PER_MIN=10
# EXP_RATE_LOGIN_PER_MIN=20
# EXP_RATE_SEARCH_PER_MIN=120
# EXP_RATE_PUSH_PER_MIN=60

# ----- Optional: LLM auto-labeling / title refinement -----
# Reward annotation + title rewriting are off unless configured.
# EXP_AUTO_LABEL_ENABLED=0
# EXP_AUTO_LABEL_MODEL=claude-haiku-4-5-20251001
# EXP_AUTO_LABEL_BASE_URL=https://api.anthropic.com
# EXP_AUTO_LABEL_API_KEY=

# ----- Optional: OPF (deep privacy filter) worker -----
# EXP_DEFER_OPF=1
# EXP_OPF_REMOTE_URL=
# EXP_OPF_AUTH_TOKEN=

# ----- Optional: plugin distribution -----
# Public npm package name shown on the /plugins page.
# EXP_PLUGIN_NPM_PACKAGE=@your-scope/expool-plugin
# Surface the experimental /fleet dashboard.
# EXP_FLEET_ENABLED=0
