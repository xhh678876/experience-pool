[Unit]
Description=Experience Pool UI
After=network.target expool.service
Wants=expool.service

[Service]
Type=simple
User=expool
Group=expool
WorkingDirectory=/opt/experience-pool/ui
Environment=NODE_ENV=production
Environment=EXP_ROOT=/var/lib/expool
Environment=EXP_DB_PATH=/var/lib/expool/pool.db
Environment=EXP_TRAJECTORIES_DIR=/var/lib/expool/trajectories
Environment=EXP_API_BASE=http://127.0.0.1:8080
Environment=EXP_SERVICE_HOST=127.0.0.1
Environment=EXP_UI_PORT=3000
EnvironmentFile=-/etc/expool/expool.env
ExecStart=/usr/bin/npm run start -- --hostname ${EXP_SERVICE_HOST} --port ${EXP_UI_PORT}
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
