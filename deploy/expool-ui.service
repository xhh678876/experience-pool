[Unit]
Description=Experience Pool UI
After=network.target expool.service
Wants=expool.service

[Service]
Type=simple
User=expool
Group=expool
WorkingDirectory=/opt/experience-pool/ui
Environment=NODE_ENV=production
Environment=EXP_DB_PATH=/var/lib/expool/pool.db
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
